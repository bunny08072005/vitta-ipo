# Structured IPO data — get a free key at https://indianapi.in
IPO_API_KEY=your_indianapi_key_here

# Which AI backend generates analysis + chat answers: "gemini" (default,
# free, no credit card — get a key at https://aistudio.google.com/apikey)
# or "anthropic" (paid, higher quality — https://console.anthropic.com)
LLM_PROVIDER=gemini

# Free tier, no credit card required
GEMINI_API_KEY=your_gemini_key_here

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Port the backend listens on (Vite's dev proxy expects this)
PORT=5174

# Best-effort secondary IPO source scraped from NSE's public (undocumented)
# JSON endpoints. Set to false to disable entirely if it becomes unreliable
# or you'd rather not depend on it.
ENABLE_NSE_SOURCE=true

# Origin allowed to call this API in dev (the Vite dev server)
CORS_ORIGIN=http://localhost:5173
